{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "schemaVersion": 12,
  "timeConvention": {
    "id": "Africa/Addis_Ababa",
    "fixedUtcOffsetMinutes": 180,
    "fixedUtcOffsetLabel": "UTC+3",
    "observesDst": false
  },
  "entities": {
    "Task": {
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "description": { "type": "string", "required": false },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "completed", "cancelled", "inbox"], "default": "not_started" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"], "default": "medium" },
        "completedAt": { "type": "string", "format": "date-time", "required": false, "plannedDatabaseSchemaVersion": 10 },
        "dueDate": { "type": "string", "format": "date", "required": false },
        "scheduledDate": { "type": "string", "format": "date", "required": false },
        "scheduledTime": { "type": "string", "format": "time", "required": false, "plannedDatabaseSchemaVersion": 10 },
        "projectId": { "type": "string", "required": false },
        "milestoneId": { "type": "string", "required": false },
        "estimatedDurationMinutes": { "type": "number", "required": false },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "required": false },
              "title": { "type": "string", "required": true },
              "done": { "type": "boolean", "required": true, "default": false }
            },
            "legacyAliases": {
              "doneFrom": "completed",
              "optionalIdOnLegacyRead": true
            }
          },
          "default": []
        },
        "labels": { "type": "array", "items": { "type": "string" }, "default": [] },
        "isPinned": { "type": "boolean", "default": false },
        "isMyDay": { "type": "boolean", "default": false },
        "myDayDate": { "type": "string", "format": "date", "required": false, "plannedDatabaseSchemaVersion": 10 },
        "recurrenceRule": { "type": "string", "required": false },
        "recurrenceConfig": {
          "type": "object",
          "required": false,
          "plannedDatabaseSchemaVersion": 10,
          "properties": {
            "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"], "required": true },
            "interval": { "type": "integer", "minimum": 1, "default": 1, "required": false },
            "weekdays": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 }, "required": false },
            "startDate": { "type": "string", "format": "date", "required": false },
            "endDate": { "type": "string", "format": "date", "required": false },
            "repeatFrom": { "type": "string", "enum": ["due_date", "completion_date"], "default": "due_date", "required": false }
          }
        },
        "isArchived": { "type": "boolean", "default": false, "plannedDatabaseSchemaVersion": 10 },
        "sortOrder": { "type": "integer", "minimum": 0, "default": 0, "required": false, "plannedDatabaseSchemaVersion": 10 },
        "createdAt": { "type": "string", "format": "date-time", "required": true },
        "updatedAt": { "type": "string", "format": "date-time", "required": false }
      }
    },
    "Milestone": {
      "fields": {
        "id": { "type": "string", "required": true },
        "projectId": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "dueDate": { "type": "string", "format": "date", "required": false },
        "isCompleted": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "DailyPlanningEntry": {
      "plannedDatabaseSchemaVersion": 10,
      "uniqueKey": ["taskId", "planDate"],
      "onTaskDelete": "cascade",
      "fields": {
        "id": { "type": "string", "required": true },
        "planDate": { "type": "string", "format": "date", "required": true },
        "taskId": { "type": "string", "required": true },
        "action": {
          "type": "string",
          "enum": ["planned", "carried_forward", "completed", "dismissed"],
          "default": "planned"
        },
        "createdAt": { "type": "string", "format": "date-time", "required": true },
        "updatedAt": { "type": "string", "format": "date-time", "required": false }
      }
    },
    "Note": {
      "fieldMappings": {
        "body": {
          "canonicalField": "body",
          "runtimeAliases": ["content"],
          "notes": "Canonical exchange field is 'body'; Flutter NoteEntity, Drift notes.content, Web DaywellNote/TaskNoteRecord, and legacy LocalNote store 'content'. Read paths accept both 'body' and 'content'."
        },
        "folder": {
          "canonicalField": "folder",
          "runtimeAliases": ["category", "notebook"],
          "defaultCanonical": "General",
          "notes": "Canonical exchange field is 'folder' (default 'General'); Flutter NoteEntity and Drift notes.category store normalized lowercase 'category' (default 'general'); Web DaywellNote/TaskNoteRecord store 'notebook' (default 'Personal'). Web SharedStateBridge accepts folder/category/notebook; Flutter NoteEntity.fromJson and DatabasePersistenceCoordinator accept category/folder."
        },
        "linkedPair": {
          "canonicalFields": ["linkedModule", "linkedId"],
          "legacyAliases": {
            "taskId": {
              "linkedModule": "tasks",
              "linkedIdFrom": "taskId",
              "supportedIn": [
                "Flutter NoteEntity.fromJson",
                "Flutter DatabasePersistenceCoordinator"
              ]
            }
          }
        },
        "timestamps": {
          "canonicalFields": ["createdAt", "updatedAt"],
          "legacyAliases": {
            "createdAtUtc": "createdAt"
          }
        }
      },
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true, "maxLength": 250 },
        "body": { "type": "string", "required": true },
        "folder": { "type": "string", "required": false, "default": "General" },
        "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
        "isPinned": { "type": "boolean", "default": false },
        "isFavorite": { "type": "boolean", "default": false },
        "isArchived": { "type": "boolean", "default": false },
        "isTrashed": { "type": "boolean", "default": false },
        "projectId": { "type": "string", "required": false },
        "goalId": { "type": "string", "required": false },
        "linkedModule": { "type": "string", "enum": ["tasks", "finance", "calendar"], "required": false },
        "linkedId": { "type": "string", "required": false },
        "createdAt": { "type": "string", "format": "date-time", "required": true },
        "updatedAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "CalendarEvent": {
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "date": { "type": "string", "format": "date", "required": true },
        "endDate": { "type": "string", "format": "date", "required": false },
        "startTime": { "type": "string", "required": false },
        "endTime": { "type": "string", "required": false },
        "isAllDay": { "type": "boolean", "default": false },
        "category": { "type": "string", "default": "general" },
        "colorHex": { "type": "string", "default": "#1B4D3E" },
        "hasReminder": { "type": "boolean", "default": false },
        "notes": { "type": "string", "required": false },
        "createdAt": { "type": "string", "format": "date-time", "required": true },
        "updatedAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "Account": {
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "type": { "type": "string", "enum": ["asset", "liability", "equity", "income", "expense", "revenue"], "default": "asset" },
        "subType": {
          "type": "string",
          "enum": [
            "cash",
            "bank",
            "mobile_money",
            "savings_vault",
            "credit_card",
            "receivable",
            "payable",
            "opening_equity",
            "nominal_income",
            "nominal_expense",
            "legacy_clearing"
          ],
          "default": "cash"
        },
        "isSystem": { "type": "boolean", "default": false },
        "currencyCode": { "type": "string", "default": "ETB" },
        "openingBalanceCents": { "type": "integer", "default": 0 },
        "openingBalanceDate": { "type": "string", "format": "date", "required": false },
        "isArchived": { "type": "boolean", "default": false }
      }
    },
    "Category": {
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "type": { "type": "string", "enum": ["income", "expense"], "required": true },
        "colorHex": { "type": "string", "default": "#1B4D3E" },
        "parentId": { "type": "string", "required": false },
        "sortOrder": { "type": "integer", "default": 0 },
        "isDefault": { "type": "boolean", "default": false },
        "isArchived": { "type": "boolean", "default": false }
      }
    },
    "Transaction": {
      "fields": {
        "id": { "type": "string", "required": true },
        "amountCents": { "type": "integer", "minimum": 1, "required": true },
        "type": { "type": "string", "enum": ["income", "expense", "transfer"], "required": true },
        "categoryId": { "type": "string", "required": false },
        "categoryName": { "type": "string", "required": false },
        "accountId": { "type": "string", "required": true },
        "accountName": { "type": "string", "required": false },
        "destinationAccountId": { "type": "string", "required": false },
        "destinationAccountName": { "type": "string", "required": false },
        "transactionDate": { "type": "string", "format": "date", "required": true },
        "note": { "type": "string", "required": false },
        "payee": { "type": "string", "required": false },
        "isSuperseded": { "type": "boolean", "default": false }
      }
    },
    "JournalEntry": {
      "fields": {
        "id": { "type": "string", "required": true },
        "entryType": {
          "type": "string",
          "enum": [
            "standard",
            "transfer",
            "debt_issuance",
            "settlement",
            "split_expense",
            "adjustment",
            "write_off"
          ],
          "default": "standard"
        },
        "description": { "type": "string", "required": true },
        "occurrenceDate": { "type": "string", "format": "date", "required": true },
        "isVoided": { "type": "boolean", "default": false },
        "voidReason": { "type": "string", "required": false },
        "legacySourceTxId": { "type": "string", "required": false },
        "correctedFromEntryId": { "type": "string", "required": false },
        "createdAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "Debt": {
      "fields": {
        "id": { "type": "string", "required": true },
        "originEntryId": { "type": "string", "required": true },
        "partyId": { "type": "string", "required": true },
        "debtType": { "type": "string", "enum": ["receivable", "payable"], "required": true },
        "principalCents": { "type": "integer", "minimum": 1, "required": true },
        "outstandingCents": { "type": "integer", "minimum": 0, "required": true },
        "dueDate": { "type": "string", "format": "date", "required": false },
        "status": {
          "type": "string",
          "enum": ["active", "settled", "written_off", "voided"],
          "default": "active"
        },
        "writeOffEntryId": { "type": "string", "required": false },
        "createdAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "Project": {
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "description": { "type": "string", "required": false },
        "status": { "type": "string", "enum": ["active", "completed", "on_hold"], "default": "active" },
        "targetDate": { "type": "string", "format": "date", "required": false },
        "goalId": { "type": "string", "required": false },
        "isArchived": { "type": "boolean", "default": false },
        "startDate": { "type": "string", "format": "date", "required": false },
        "customFields": { "type": "object", "default": {} },
        "createdAt": { "type": "string", "format": "date-time", "required": false },
        "updatedAt": { "type": "string", "format": "date-time", "required": false }
      }
    },
    "ProjectTrackingBlock": {
      "fields": {
        "id": { "type": "string", "required": true },
        "projectId": { "type": "string", "required": true },
        "blockType": {
          "type": "string",
          "enum": ["counter", "grouped_list", "checklist", "schedule"],
          "required": true
        },
        "title": { "type": "string", "required": true },
        "sortOrder": { "type": "integer", "minimum": 0, "default": 0 },
        "unitLabel": { "type": "string", "required": false },
        "targetValue": { "type": "number", "minimum": 0, "required": false },
        "dailyTargetValue": { "type": "number", "minimum": 0, "required": false },
        "config": { "type": "object", "default": {} },
        "isArchived": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time", "required": true },
        "updatedAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "ProjectTrackingRecord": {
      "fields": {
        "id": { "type": "string", "required": true },
        "projectId": { "type": "string", "required": true },
        "blockId": { "type": "string", "required": true },
        "parentRecordId": { "type": "string", "required": false },
        "recordType": {
          "type": "string",
          "enum": ["group", "grouped_item", "checklist_item", "schedule_item", "progress_log"],
          "required": true
        },
        "title": { "type": "string", "required": false },
        "sortOrder": { "type": "integer", "minimum": 0, "default": 0 },
        "targetValue": { "type": "number", "minimum": 0, "required": false },
        "deltaValue": { "type": "number", "required": false },
        "durationMinutes": { "type": "integer", "minimum": 0, "required": false },
        "isCompleted": { "type": "boolean", "default": false },
        "completedAt": { "type": "string", "format": "date-time", "required": false },
        "recordedDate": { "type": "string", "format": "date", "required": false },
        "scheduledDate": { "type": "string", "format": "date", "required": false },
        "linkedTaskId": { "type": "string", "required": false },
        "metadata": { "type": "object", "default": {} },
        "createdAt": { "type": "string", "format": "date-time", "required": true },
        "updatedAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "Goal": {
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "description": { "type": "string", "required": false },
        "status": { "type": "string", "enum": ["active", "achieved", "archived"], "default": "active" },
        "targetDate": { "type": "string", "format": "date", "required": false }
      }
    },
    "InboxItem": {
      "fields": {
        "id": { "type": "string", "required": true },
        "rawText": { "type": "string", "required": true },
        "category": { "type": "string", "enum": ["task", "idea", "expense", "note", "problem", "decision", "general"], "default": "task" },
        "isProcessed": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "Commitment": {
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "amountCents": { "type": "integer", "minimum": 1, "required": true },
        "dueDate": { "type": "string", "format": "date", "required": true },
        "isPaid": { "type": "boolean", "default": false },
        "recurringRule": { "type": "string", "required": false },
        "linkedAccountId": { "type": "string", "required": false },
        "categoryId": { "type": "string", "required": false },
        "linkedDebtId": { "type": "string", "required": false },
        "settlementEntryId": { "type": "string", "required": false },
        "recurringRuleId": { "type": "string", "required": false },
        "direction": { "type": "string", "enum": ["outflow", "inflow"], "default": "outflow" },
        "legacyPaidUnverified": { "type": "boolean", "default": false }
      }
    },
    "CommitmentSettlement": {
      "fields": {
        "id": { "type": "string", "required": true },
        "commitmentId": { "type": "string", "required": true },
        "entryId": { "type": "string", "required": true },
        "amountCents": { "type": "integer", "minimum": 1, "required": true },
        "settledDate": { "type": "string", "format": "date", "required": true },
        "createdAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "SavingsGoal": {
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "targetCents": { "type": "integer", "minimum": 1, "required": true },
        "currentAllocatedCents": { "type": "integer", "minimum": 0, "default": 0 },
        "targetDate": { "type": "string", "format": "date", "required": false },
        "linkedAccountId": { "type": "string", "required": false },
        "status": { "type": "string", "enum": ["active", "completed", "archived"], "default": "active" }
      }
    },
    "Budget": {
      "fields": {
        "id": { "type": "string", "required": true },
        "categoryId": { "type": "string", "required": true },
        "monthIso": { "type": "string", "required": true },
        "limitCents": { "type": "integer", "minimum": 1, "required": true },
        "rolloverEnabled": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time", "required": true },
        "updatedAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "RecurringRule": {
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "ruleType": { "type": "string", "enum": ["expense", "income", "transfer", "commitment"], "required": true },
        "amountCents": { "type": "integer", "minimum": 1, "required": true },
        "frequency": { "type": "string", "enum": ["weekly", "biweekly", "monthly", "quarterly", "yearly"], "required": true },
        "interval": { "type": "integer", "minimum": 1, "default": 1 },
        "startDate": { "type": "string", "format": "date", "required": true },
        "nextOccurrenceDate": { "type": "string", "format": "date", "required": true },
        "endDate": { "type": "string", "format": "date", "required": false },
        "accountId": { "type": "string", "required": false },
        "destinationAccountId": { "type": "string", "required": false },
        "categoryId": { "type": "string", "required": false },
        "linkedDebtId": { "type": "string", "required": false },
        "isActive": { "type": "boolean", "default": true },
        "autoPost": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time", "required": true }
      }
    },
    "Reminder": {
      "fields": {
        "id": { "type": "string", "required": true },
        "targetId": { "type": "string", "required": true },
        "targetType": {
          "type": "string",
          "enum": ["task", "commitment", "calendar_event", "note", "custom"],
          "required": true
        },
        "triggerTimeUtc": { "type": "string", "format": "date-time", "required": true },
        "isActive": { "type": "boolean", "default": true },
        "createdAt": { "type": "string", "format": "date-time", "required": true },
        "title": { "type": "string", "required": false },
        "channelId": { "type": "string", "required": false }
      }
    },
    "AppSetting": {
      "fields": {
        "key": { "type": "string", "required": true },
        "value": { "type": "string", "required": true },
        "updatedAt": { "type": "string", "format": "date-time", "required": false }
      }
    },
    "DailyRhythmDay": {
      "plannedDatabaseSchemaVersion": 12,
      "uniqueKey": ["dateIso"],
      "fields": {
        "dateIso": { "type": "string", "format": "date", "required": true },
        "bibleStudyDone": { "type": "boolean", "default": false },
        "bibleStudyCompletedAt": { "type": "string", "format": "date-time", "required": false },
        "prayerDone": { "type": "boolean", "default": false },
        "prayerCompletedAt": { "type": "string", "format": "date-time", "required": false },
        "taskReviewConfirmed": { "type": "boolean", "default": false },
        "taskReviewedAt": { "type": "string", "format": "date-time", "required": false },
        "taskReviewEvidence": {
          "type": "object",
          "required": false,
          "properties": {
            "overdueCount": { "type": "integer", "minimum": 0, "default": 0 },
            "todayCount": { "type": "integer", "minimum": 0, "default": 0 },
            "plannedCount": { "type": "integer", "minimum": 0, "default": 0 },
            "completedTodayCount": { "type": "integer", "minimum": 0, "default": 0 }
          }
        },
        "financeCloseStatus": {
          "type": "string",
          "enum": [
            "open",
            "closed_with_transactions",
            "closed_no_transactions",
            "needs_reconfirmation"
          ],
          "default": "open"
        },
        "financeClosedAt": { "type": "string", "format": "date-time", "required": false },
        "updatedAt": { "type": "string", "format": "date-time", "required": true }
      }
    }
  }
}
