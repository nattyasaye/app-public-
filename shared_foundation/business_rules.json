{
  "version": "1.0.0",
  "finance": {
    "currencyCode": "ETB",
    "minorUnitsPerMajor": 100,
    "rules": {
      "integerCentsOnly": true,
      "rejectZeroOrNegativeAmount": true,
      "rejectIdenticalTransferAccounts": true,
      "transferPreservesCombinedBalance": true,
      "guardAccountDeletionIfTransactionsExist": true,
      "guardCategoryDeletionIfTransactionsExist": true
    },
    "formulas": {
      "accountBalance": "openingBalanceCents + totalIncomeCents - totalExpenseCents + incomingTransfersCents - outgoingTransfersCents",
      "combinedBalance": "sumOfAllActiveAssetAccountBalances"
    }
  },
  "tasks": {
    "priorityWeights": {
      "urgent": 4,
      "high": 3,
      "medium": 2,
      "low": 1
    },
    "statuses": ["not_started", "in_progress", "completed", "cancelled", "inbox"],
    "priorities": ["low", "medium", "high", "urgent"],
    "recurrenceFrequencies": ["daily", "weekly", "monthly", "yearly"],
    "recurrenceRepeatFromModes": ["due_date", "completion_date"],
    "defaultRecurrenceRepeatFrom": "due_date",
    "recurrenceCalendarBasis": "gregorian",
    "weekdayConvention": "iso_1_to_7",
    "minWeekday": 1,
    "maxWeekday": 7,
    "minRecurrenceInterval": 1,
    "dailyPlanningUniqueKey": ["taskId", "planDate"],
    "dailyPlanningOnTaskDelete": "cascade",
    "subtaskCanonicalFields": ["id", "title", "done"],
    "subtaskLegacyDoneAlias": "completed",
    "subtaskLegacyIdOptional": true,
    "defaultPriority": "medium",
    "defaultStatus": "not_started",
    "rules": {
      "deriveReminderStateFromReminders": true,
      "singleCompletionSourceInStatus": true,
      "utcIsoCompletedAt": true,
      "preserveMyDayPlanningHistory": true,
      "separateInboxFromUnassignedTasks": true,
      "uniqueDailyPlanningEntryPerTaskDate": true,
      "cascadeDeleteDailyPlanningOnTaskDelete": true
    }
  },
  "calendar": {
    "system": "ethiopian_dual",
    "monthsCount": 13,
    "standardMonthDays": 30,
    "pagumeStandardDays": 5,
    "pagumeLeapDays": 6,
    "pagumeLeapRule": "year % 4 == 3",
    "canonicalDateFormat": "YYYY-MM-DD",
    "timeConvention": "UTC+3",
    "fixedUtcOffsetMinutes": 180
  },
  "projects": {
    "statuses": ["active", "completed", "on_hold"],
    "blockTypes": ["counter", "grouped_list", "checklist", "schedule"],
    "recordTypes": ["group", "grouped_item", "checklist_item", "schedule_item", "progress_log"],
    "customFieldTypes": ["text", "number", "date", "boolean", "select"],
    "bounds": {
      "maxBlocksPerProject": 32,
      "maxCustomFieldDefinitions": 24,
      "maxCustomFieldSelectOptions": 50,
      "maxCustomFieldIdLength": 64,
      "maxCustomFieldTextLength": 1000,
      "maxTrackingRecordTitleLength": 300,
      "maxHierarchyDepth": 3
    },
    "rules": {
      "appendOnlyProgressLogs": true,
      "allowCompensatingCorrections": true,
      "allowMultipleIndependentMetrics": true,
      "disallowImplicitMetricAveraging": true,
      "requiresExplicitPrimaryBlockForOverallPercent": true,
      "requirePositiveProgressLogDelta": true,
      "preventDuplicateRollupLogging": true,
      "enforceParentChildOwnership": true
    }
  },
  "projectPackage": {
    "formatId": "daywell_project_package",
    "currentFormatVersion": 1,
    "minSupportedFormatVersion": 1,
    "fileExtension": ".daywellproject"
  }
}
