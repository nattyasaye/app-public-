        "lineHeight": 24,
        "fontWeight": 600,
        "letterSpacing": -0.1,
        "fontFamily": "sans",
        "tabularFigures": false
      },
      "body": {
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": 400,
        "letterSpacing": 0,
        "fontFamily": "sans",
        "tabularFigures": false
      },
      "bodyCompact": {
        "fontSize": 13,
        "lineHeight": 18,
        "fontWeight": 400,
        "letterSpacing": 0,
        "fontFamily": "sans",
        "tabularFigures": false
      },
      "label": {
        "fontSize": 12,
        "lineHeight": 16,
        "fontWeight": 600,
        "letterSpacing": 0.2,
        "fontFamily": "sans",
        "tabularFigures": false
      },
      "caption": {
        "fontSize": 11,
        "lineHeight": 14,
        "fontWeight": 500,
        "letterSpacing": 0.2,
        "fontFamily": "sans",
        "tabularFigures": false
      },
      "numericHero": {
        "fontSize": 32,
        "lineHeight": 38,
        "fontWeight": 700,
        "letterSpacing": -0.5,
        "fontFamily": "sans",
        "tabularFigures": true
      },
      "numericBody": {
        "fontSize": 15,
        "lineHeight": 20,
        "fontWeight": 600,
        "letterSpacing": 0,
        "fontFamily": "sans",
        "tabularFigures": true
      },
      "mono": {
        "fontSize": 12,
        "lineHeight": 16,
        "fontWeight": 500,
        "letterSpacing": 0,
        "fontFamily": "mono",
        "tabularFigures": true
      }
    }
