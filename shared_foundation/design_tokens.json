  "typography": {
    "fontFamilySerif": "Newsreader, Georgia, serif",
    "fontFamilySans": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
    "fontFamilyMono": "JetBrains Mono, monospace",
    "scale": {
      "display": {
        "fontSize": 28,
        "lineHeight": 36,
        "fontWeight": 700,
        "letterSpacing": -0.5,
        "fontFamily": "serif",
        "tabularFigures": false
      },
      "heading": {
        "fontSize": 22,
        "lineHeight": 28,
        "fontWeight": 700,
        "letterSpacing": -0.3,
        "fontFamily": "serif",
        "tabularFigures": false
