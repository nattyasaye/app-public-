  "spacing": {
    "xs": 4,
    "sm": 8,
    "compact": 12,
    "md": 16,
    "lg": 24,
    "xl": 32
  },
  "radii": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "sheet": 24,
    "full": 9999
  },
  "elevation": {
    "none": 0,
    "low": 1,
    "medium": 3,
    "high": 6
  },
  "breakpoints": {
    "medium": 600,
    "expanded": 840,
    "maxContentWidth": 720,
    "maxWideWidth": 1120
  }
